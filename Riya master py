# 4. INTRUSION DEFENDER
# =========================================================
class IntrusionDefender:
    FAIL_PATTERNS = [
        re.compile(r"Failed password for .* from (?P<ip>\d+\.\d+\.\d+\.\d+)"),
        re.compile(r"Invalid user .* from (?P<ip>\d+\.\d+\.\d+\.\d+)"),
        re.compile(
            r"authentication failure;.*rhost=(?P<ip>\d+\.\d+\.\d+\.\d+)"),
        re.compile(r"client: (?P<ip>\d+\.\d+\.\d+\.\d+)"),
    ]

    def __init__(self, db, executor):
        self.db = db
        self.executor = executor
        self.fail_window = defaultdict(deque)
        self.alert_queue = deque(maxlen=100)
        self._stop = threading.Event()

    def start(self):
        if not DEFENDER_ENABLED:
            log.info("Defender disabled")
            return
        threading.Thread(
            target=self._loop, name="ria-defender", daemon=True).start()
        log.info("Defender started; auth log=%s", AUTH_LOG)

    def drain_alerts(self):
        out = []
        while True:
            try:
                out.append(self.alert_queue.popleft())
            except IndexError:
                break
        return out

    def _loop(self):
        path = Path(AUTH_LOG)
        pos = path.stat().st_size if path.exists() else 0
        while not self._stop.is_set():
            try:
                if path.exists():
                    size = path.stat().st_size
                    if size < pos:
                        pos = 0
                    if size > pos:
                        with path.open("r", errors="replace") as f:
                            f.seek(pos)
                            for line in f:
                                self._inspect(line)
                            pos = f.tell()
                self._decay()
            except Exception as e:
                log.warning("defender loop error: %s", safe_error(e))
            self._stop.wait(DEFENDER_SCAN_INTERVAL)

    def _inspect(self, line):
        for pat in self.FAIL_PATTERNS:
            m = pat.search(line)
            if not m:
                continue
            ip = m.group("ip")
            if ip in DEFENDER_WHITELIST:
                return
            now = time.time()
            dq = self.fail_window[ip]
            dq.append(now)
            if len(dq) >= DEFENDER_FAIL_THRESHOLD:
                self._block(ip, reason="repeated_auth_failure",
                            detail=line.strip()[:500])
                dq.clear()
            return

    def _decay(self):
        cutoff = time.time() - DEFENDER_WINDOW_SEC
        for ip in list(self.fail_window.keys()):
            dq = self.fail_window[ip]
            while dq and dq[0] < cutoff:
                dq.popleft()
            if not dq:
                del self.fail_window[ip]

  