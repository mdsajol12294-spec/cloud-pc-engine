class Database:
    def __init__(self):
        self.lock = threading.RLock()
        self._init()

    def _conn(self):
        c = sqlite3.connect(str(DB_PATH), timeout=15)
        c.row_factory = sqlite3.Row
        return c

    def _init(self):
        with self._conn() as db:
            db.execute("""CREATE TABLE IF NOT EXISTS messages(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                role TEXT NOT NULL, content TEXT NOT NULL,
                created_at TEXT NOT NULL)""")
            db.execute("""CREATE TABLE IF NOT EXISTS audit(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                level TEXT, event TEXT, created_at TEXT)""")
            db.execute("""CREATE TABLE IF NOT EXISTS pending_actions(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                action TEXT NOT NULL, command TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'pending',
                reason TEXT DEFAULT '',
                parent_id INTEGER DEFAULT NULL,
                retry_count INTEGER DEFAULT 0,
                created_at TEXT NOT NULL)""")
            db.execute("""CREATE TABLE IF NOT EXISTS blacklist(
                ip TEXT PRIMARY KEY, reason TEXT,
                blocked_at TEXT NOT NULL)""")
            db.execute("""CREATE TABLE IF NOT EXISTS threats(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                ip TEXT, kind TEXT, detail TEXT,
                evidence_path TEXT, created_at TEXT NOT NULL)""")
            db.execute("""CREATE TABLE IF NOT EXISTS command_log(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                command TEXT NOT NULL, exit_code INTEGER,
                output TEXT, retry_of INTEGER DEFAULT NULL,
                created_at TEXT NOT NULL)""")
            db.execute("""CREATE TABLE IF NOT EXISTS prefs(
                key TEXT PRIMARY KEY, value TEXT)""")
            db.execute("""CREATE TABLE IF NOT EXISTS mood_state(
                axis TEXT PRIMARY KEY, value REAL NOT NULL)""")
            db.execute("""CREATE TABLE IF NOT EXISTS mood_history(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                axis TEXT, old_value REAL, new_value REAL,
                trigger TEXT, created_at TEXT NOT NULL)""")
            db.execute("""CREATE TABLE IF NOT EXISTS milestones(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                label TEXT NOT NULL, detail TEXT,
                importance REAL DEFAULT 0.5,
                created_at TEXT NOT NULL)""")
            db.execute("""CREATE TABLE IF NOT EXISTS prefetch(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                command TEXT NOT NULL, suggestion TEXT,
                created_at TEXT NOT NULL)""")
        with self._conn() as db:
            for axis, val in MOOD_DEFAULTS.items():
                db.execute(
                    "INSERT OR IGNORE INTO mood_state(axis,value) VALUES(?,?)",
                    (axis, val))

    def add_message(self, role, content):
        with self.lock, self._conn() as db:
            db.execute(
                "INSERT INTO messages(role,content,created_at) VALUES(?,?,?)",
                (role, content, stamp()))

    def history(self, limit=20):
        with self.lock, self._conn() as db:
            rows = db.execute(
                "SELECT role,content FROM messages ORDER BY id DESC LIMIT ?",
                (limit,)).fetchall()
        return list(reversed([dict(r) for r in rows]))

    def audit(self, level, event):
        log.info("%s: %s", level, event)
        with self.lock, self._conn() as db:
            db.execute(
                "INSERT INTO audit(level,event,created_at) VALUES(?,?,?)",
                (level, event, stamp()))

    def add_pending(self, action, command, reason="", parent_id=None,
                    retry_count=0):
        with self.lock, self._conn() as db:
            cur = db.execute(
                "INSERT INTO pending_actions(action,command,reason,parent_id,"
                "retry_count,created_at) VALUES(?,?,?,?,?,?)",
                (action, command, reason, parent_id, retry_count, stamp()))
            return cur.lastrowid

    def get_pending(self, pid):
        with self.lock, self._conn() as db:
            row = db.execute(
                "SELECT * FROM pending_actions "
                "WHERE id=? AND status='pending'", (pid,)).fetchone()
        return dict(row) if row else None

    def resolve_pending(self, pid, status):
        with self.lock, self._conn() as db:
            db.execute(
                "UPDATE pending_actions SET status=? WHERE id=?",
                (status, pid))

    def is_blacklisted(self, ip):
        with self.lock, self._conn() as db:
            row = db.execute(
                "SELECT ip FROM blacklist WHERE ip=?", (ip,)).fetchone()
        return row is not None

    def blacklist(self, ip, reason):
        with self.lock, self._conn() as db:
            db.execute(
                "INSERT OR REPLACE INTO blacklist(ip,reason,blocked_at) "
                "VALUES(?,?,?)", (ip, reason, stamp()))

    def add_threat(self, ip, kind, detail, evidence_path=""):
        with self.lock, self._conn() as db:
            db.execute(
                "INSERT INTO threats(ip,kind,detail,evidence_path,created_at)"
                " VALUES(?,?,?,?,?)",
                (ip, kind, detail, evidence_path, stamp()))

    def recent_threats(self, limit=50):
        with self.lock, self._conn() as db:
            rows = db.execute(
                "SELECT * FROM threats ORDER BY id DESC LIMIT ?",
                (limit,)).fetchall()
        return [dict(r) for r in rows]

    def log_command(self, command, exit_code, output, retry_of=None):
        with self.lock, self._conn() as db:
            db.execute(
                "INSERT INTO command_log(command,exit_code,output,retry_of,"
                "created_at) VALUES(?,?,?,?,?)",
                (command, exit_code, output[:2000], retry_of, stamp()))

    def set_pref(self, key, value):
        with self.lock, self._conn() as db:
            db.execute(
                "INSERT OR REPLACE INTO prefs(key,value) VALUES(?,?)",
                (key, value))

    def get_pref(self, key, default=None):
        with self.lock, self._conn() as db:
            row = db.execute(
                "SELECT value FROM prefs WHERE key=?", (key,)).fetchone()
        return row["value"] if row else default

    def get_moods(self):
        with self.lock, self._conn() as db:
            rows = db.execute("SELECT axis,value FROM mood_state").fetchall()
        return {r["axis"]: float(r["value"]) for r in rows}

    def set_mood(self, axis, value, trigger=""):
        old = self.get_moods().get(axis, MOOD_DEFAULTS.get(axis, 0.5))
        new = clamp(value)
        if abs(new - old) < 1e-4:
            return old, new
        with self.lock, self._conn() as db:
            db.execute(
                "INSERT OR REPLACE INTO mood_state(axis,value) VALUES(?,?)",
                (axis, new))
            db.execute(
                "INSERT INTO mood_history(axis,old_value,new_value,trigger,"
                "created_at) VALUES(?,?,?,?,?)",
                (axis, old, new, trigger, stamp()))
            db.execute(
                "DELETE FROM mood_history WHERE id NOT IN ("
                "SELECT id FROM mood_history ORDER BY id DESC LIMIT ?)",
                (MOOD_HISTORY_KEEP,))
        return old, new

    def bump_moods(self, deltas, trigger=""):
        cur = self.get_moods()
        out = {}
        for axis, d in deltas.items():
            if axis not in MOOD_DEFAULTS:
                continue
            old, new = self.set_mood(axis, cur.get(axis, 0.5) + d, trigger)
            out[axis] = (old, new)
        return out

    def mood_summary(self):
        m = self.get_moods()
        if not m:
            return "neutral", {}
        dom = max(m, key=m.get)
        return dom, m

    def add_milestone(self, label, detail="", importance=0.5):
        with self.lock, self._conn() as db:
            cur = db.execute(
                "INSERT INTO milestones(label,detail,importance,created_at)"
                " VALUES(?,?,?,?)",
                (label, detail, importance, stamp()))
            return cur.lastrowid

    def recent_milestones(self, limit=5):
        with self.lock, self._conn() as db:
            rows = db.execute(
                "SELECT * FROM milestones ORDER BY id DESC LIMIT ?",
                (limit,)).fetchall()
        return [dict(r) for r in rows]

    def search_milestones(self, keyword, limit=5):
        like = f"%{keyword}%"
        with self.lock, self._conn() as db:
            rows = db.execute(
                "SELECT * FROM milestones WHERE label LIKE ? OR detail LIKE ?"
                " ORDER BY id DESC LIMIT ?",
                (like, like, limit)).fetchall()
        return [dict(r) for r in rows]

    def add_prefetch(self, command, suggestion):
        with self.lock, self._conn() as db:
            db.execute(
                "INSERT INTO prefetch(command,suggestion,created_at) "
                "VALUES(?,?,?)", (command, suggestion, stamp()))

    def get_prefetch(self, command):
        with self.lock, self._conn() as db:
            row = db.execute(
                "SELECT suggestion FROM prefetch WHERE command=? "
                "ORDER BY id DESC LIMIT 1", (command,)).fetchone()
        return row["suggestion"] if row else None


