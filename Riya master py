# 3. SAFE EXECUTOR
# =========================================================
class SafeExecutor:
    ALLOWLIST = {
        "nmap", "masscan", "rustscan", "whois", "dig", "nslookup",
        "curl", "wget", "git", "python3", "bash", "ls", "pwd", "cat",
        "head", "tail", "grep", "find", "which", "echo", "uname",
        "ifconfig", "ip", "ss", "netstat", "ping", "traceroute",
        "nikto", "gobuster", "ffuf", "dirb", "whatweb", "nuclei",
        "sqlmap", "hydra", "john", "hashcat", "strings", "file",
        "exiftool", "binwalk", "strace", "ps", "df", "du", "free",
        "ufw", "iptables", "journalctl", "lastb", "last", "who",
    }
    DENY = [
        r"rm\s+-rf\s+/", r"mkfs", r"dd\s+if=.*of=/dev/",
        r":\(\)\s*\{.*\};:", r"chmod\s+777\s+/",
        r">\s*/dev/sd", r"shutdown", r"reboot", r"init\s+0",
        r"\|\s*bash", r"\|\s*sh\b", r"curl.*\|\s*sh",
        r"wget.*\|\s*sh", r"eval\s*\(", r"exec\s*\(",
    ]

    def __init__(self, db):
        self.db = db

    def validate(self, command):
        if not command or len(command) > 4000:
            return False, "empty/too_long"
        for pat in self.DENY:
            if re.search(pat, command.lower()):
                return False, f"blocked_pattern: {pat}"
        if re.search(r"[;&|`$><]", command):
            return False, "shell_metacharacter"
        try:
            parts = shlex.split(command)
        except ValueError as e:
            return False, f"parse: {e}"
        if not parts:
            return False, "empty"
        if os.path.basename(parts[0]) not in self.ALLOWLIST:
            return False, f"not_allowed: {parts[0]}"
        return True, parts

    def execute(self, command, auto=False, retry_of=None):
        ok, res = self.validate(command)
        if not ok:
            self.db.audit("DENY", f"{command} :: {res}")
            self.db.log_command(command, -1, f"[BLOCKED] {res}", retry_of)
            return {"exit_code": -1, "output": f"[BLOCKED] {res}"}
        self.db.audit("EXEC_AUTO" if auto else "EXEC", command)
        try:
            p = subprocess.run(
                res, cwd=str(ROOT), capture_output=True,
                text=True, timeout=COMMAND_TIMEOUT, shell=False)
            out = ""
            if p.stdout.strip():
                out += f"[STDOUT]\n{p.stdout.strip()}\n"
            if p.stderr.strip():
                out += f"[STDERR]\n{p.stderr.strip()}\n"
            if not out:
                out = "[No output]"
            if len(out) > 12000:
                out = out[:12000] + "\n...[TRUNCATED]..."
            self.db.log_command(command, p.returncode, out, retry_of)
            return {"exit_code": p.returncode, "output": out}
        except subprocess.TimeoutExpired:
            self.db.log_command(
                command, -1, f"[TIMEOUT] {COMMAND_TIMEOUT}s", retry_of)
            return {"exit_code": -1,
                    "output": f"[TIMEOUT] {COMMAND_TIMEOUT}s"}
        except Exception as e:
            self.db.log_command(
                command, -1, f"[ERROR] {safe_error(e)}", retry_of)
            return {"exit_code": -1, "output": f"[ERROR] {safe_error(e)}"}


